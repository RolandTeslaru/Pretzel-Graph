FROM node:22-alpine AS build
WORKDIR /repo

COPY package.json package-lock.json ./
COPY patches ./patches
COPY packages/backend/package.json    ./packages/backend/
COPY packages/frontend/package.json   ./packages/frontend/
COPY packages/nodes/package.json      ./packages/nodes/
COPY packages/node-sdk/package.json   ./packages/node-sdk/
COPY packages/shared/package.json     ./packages/shared/
COPY packages/standard-ui/package.json ./packages/standard-ui/
COPY packages/webhook/package.json    ./packages/webhook/
COPY packages/worker/package.json     ./packages/worker/
RUN npm ci

COPY packages ./packages

# Baked in at build time: everything is served from one origin, so these are paths.
ENV VITE_API_URL=/
ARG VITE_AUTH_URL=http://localhost:9999
ENV VITE_AUTH_URL=$VITE_AUTH_URL
ARG VITE_CLOUD_URL=
ENV VITE_CLOUD_URL=$VITE_CLOUD_URL
RUN npx vite build --config packages/frontend/vite.config.ts packages/frontend

FROM nginx:alpine AS runtime
COPY --from=build /repo/packages/frontend/dist /usr/share/nginx/html
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY docker/nginx/proxy.conf   /etc/nginx/proxy.conf
EXPOSE 80
