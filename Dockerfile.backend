# Built from the repo root: the workspace packages compile together.
FROM node:22-alpine AS build
WORKDIR /repo

COPY package.json package-lock.json ./
COPY patches ./patches
COPY packages/backend/package.json    ./packages/backend/
COPY packages/frontend/package.json   ./packages/frontend/
COPY packages/nodes/package.json      ./packages/nodes/
COPY packages/node-sdk/package.json   ./packages/node-sdk/
COPY packages/shared/package.json     ./packages/shared/
COPY packages/standard-ui/package.json ./packages/standard-ui/
COPY packages/webhook/package.json    ./packages/webhook/
COPY packages/worker/package.json     ./packages/worker/
RUN npm ci

COPY packages ./packages
# Regenerates the blueprint index before the backend build copies assets into dist.
RUN npm run generate-indexes --workspace=packages/nodes \
 && npm run build --workspace=packages/backend \
 && npm run build --workspace=packages/nodes

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production

# The queue lives on this machine; the worker connects to it over the network.
RUN apk add --no-cache redis

COPY package.json package-lock.json ./
COPY patches ./patches
COPY --from=build /repo/packages/backend/package.json ./packages/backend/
COPY --from=build /repo/packages/worker/package.json  ./packages/worker/
COPY --from=build /repo/packages/nodes/package.json   ./packages/nodes/
RUN npm ci --omit=dev --workspace=packages/backend --workspace=packages/nodes --ignore-scripts

COPY --from=build /repo/packages/backend/dist ./packages/backend/dist
COPY --from=build /repo/packages/nodes/dist   ./packages/nodes/dist

# The catalogue resolves node and blueprint modules under this directory.
ENV NODES_ROOT=/app/packages/nodes/dist/nodes/src
COPY docker/backend/entrypoint.sh ./entrypoint.sh

# Redis is this machine's, on the workspace network.
ENV REDIS_HOST=127.0.0.1
ENV REDIS_PORT=6379
# The worker reaches the backend over the network; the backend reaches itself.
ENV API_URL=http://127.0.0.1:3001
EXPOSE 3001

# Reports serving, not merely started. start-period covers boot migrations.
HEALTHCHECK --interval=5s --timeout=3s --start-period=45s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:3001/health || exit 1

CMD ["./entrypoint.sh"]
