{
    "name": "@pretzel-graph/nodes",
    "version": "1.0.0",
    "description": "Node implementations for the PretzelGraph execution engine",
    "main": "src/index.ts",
    "types": "src/index.ts",
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "test": "tsx --test",
        "test:polymarket:live": "POLYMARKET_LIVE_TESTS=1 tsx --test src/Integrations/Polymarket/tests/live.test.ts",
        "generate-indexes": "tsx src/Core/scripts/generateIndexes.ts",
        "watch:indexes": "tsx src/Core/scripts/watchIndexes.ts",
        "dump-tool-samples": "tsx scripts/dumpToolSamples.ts"
    },
    "dependencies": {
        "@alpacahq/alpaca-trade-api": "4.0.1",
        "@langchain/anthropic": "*",
        "@langchain/community": "*",
        "@langchain/core": "*",
        "@langchain/google-genai": "*",
        "@langchain/openai": "*",
        "@langchain/openrouter": "*",
        "@langchain/xai": "*",
        "@polymarket/clob-client-v2": "1.1.0",
        "@pretzel-graph/node-sdk": "*",
        "@pretzel-graph/shared": "*",
        "@pretzel-graph/worker": "*",
        "axios": "*",
        "kalshi-typescript": "3.26.0",
        "lodash": "^4.17.23",
        "pg": "^8.22.0",
        "viem": "^2.47.12",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/pg": "^8.21.0",
        "tsc-alias": "^1.9.1"
    }
}
