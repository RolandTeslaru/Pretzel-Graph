{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        // CommonJS so the catalogue's dynamic import downlevels to require(),
        // which resolves the extensionless node/blueprint paths.
        "module": "CommonJS",
        "moduleResolution": "Node10",
        // `..` so the workspace packages it imports compile alongside it.
        "rootDir": "..",
        "outDir": "./dist",
        "baseUrl": ".",
        // These publish types only through an `exports` map, which Node10
        // resolution cannot read.
        "paths": {
            "@pretzel-graph/node-sdk": ["../node-sdk/src/index.ts"],
            "@pretzel-graph/node-sdk/*": ["../node-sdk/src/*"],
            "@pretzel-graph/shared/*": ["../shared/*"],
            "@pretzel-graph/nodes/*": ["./src/*"],
            "@pretzel-graph/worker": ["../worker/src/index.ts"],
            "@pretzel-graph/worker/*": ["../worker/src/*"],
            "src/*": ["../worker/src/*"],
            "http-proxy-agent": ["../../node_modules/http-proxy-agent/dist"],
            "https-proxy-agent": ["../../node_modules/https-proxy-agent/dist"],
            "socks-proxy-agent": ["../../node_modules/socks-proxy-agent/dist"]
        }
    },
    "exclude": ["node_modules", "dist", "**/*.test.ts", "**/tests/**", "scripts/**"]
}
