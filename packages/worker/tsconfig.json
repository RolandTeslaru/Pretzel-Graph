{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "noImplicitOverride": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "paths": {
            "src/*": [
                "./src/*"
            ],
            "@vx-agent-editor/shared/*": [
                "../shared/*"
            ],
            "@vx-agent-editor/blueprints/*": [
                "../blueprints/src/*"
            ],
            "@vx-agent-editor/nodes/*": [
                "../nodes/src/*"
            ]
        }
    },
    "include": [
        "src/**/*",
        "src/nodes/Core/Chat/Input/blueprint.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ],
}