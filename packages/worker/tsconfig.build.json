{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "declaration": true,
        "rootDir": "./src",
        "outDir": "./dist",
        "paths": {
            "src/*": [
                "./src/*"
            ],
            "@pretzel-graph/shared/*": [
                "../shared/dist/*"
            ],
            "@pretzel-graph/blueprints/*": [
                "../blueprints/src/*"
            ],
            "@pretzel-graph/nodes/*": [
                "../nodes/src/*"
            ]
        }
    },
    "references": [
        { "path": "../shared" }
    ]
}
