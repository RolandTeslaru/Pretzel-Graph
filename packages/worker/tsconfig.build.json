{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "declaration": true,
        // CommonJS so the output runs under plain node: the ESM emit uses
        // extensionless specifiers, which Node's ESM resolver rejects.
        "module": "CommonJS",
        "moduleResolution": "Node10",
        // `..` so the workspace packages it imports compile alongside it; `./src`
        // would put them outside rootDir. Output mirrors that: dist/worker/src.
        "rootDir": "..",
        "outDir": "./dist",
        // tsc-alias rewrites the path aliases in the emitted JS, and needs this.
        "baseUrl": ".",
        "paths": {
            "src/*": ["./src/*"],
            "@pretzel-graph/worker": ["./src/index.ts"],
            "@pretzel-graph/node-sdk": ["../node-sdk/src/index.ts"],
            "@pretzel-graph/node-sdk/*": ["../node-sdk/src/*"],
            "@pretzel-graph/shared/*": ["../shared/*"],
            "@pretzel-graph/nodes/*": ["../nodes/src/*"],
            "http-proxy-agent": ["../../node_modules/http-proxy-agent/dist"],
            "https-proxy-agent": ["../../node_modules/https-proxy-agent/dist"],
            "socks-proxy-agent": ["../../node_modules/socks-proxy-agent/dist"]
        }
    }
}
