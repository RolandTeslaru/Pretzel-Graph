{
    "name": "@vx-agent-builder/worker",
    "version": "1.0.0",
    "description": "Vexr Agentic Graph Execution Engine based on LangGraph",
    "main": "dist/index.js",
    "types": "src/index.ts",
    "scripts": {
        "build": "tsc --build tsconfig.build.json",
        "dev": "concurrently \"npm:watch:indexes\" \"tsx watch src/server.ts\" --names \"INDEX,SERVER\" --prefix-colors \"blue,green\"",
        "start": "node dist/server.js",
        "generate-indexes": "tsx scripts/generateIndexes.ts",
        "watch:indexes": "tsx scripts/watchIndexes.ts",
        "test": "jest"
    },
    "dependencies": {
        "@vx-agent-editor/shared": "*",
        "axios": "^1.13.6",
        "bullmq": "^5.67.2",
        "dotenv": "^17.3.1",
        "immer": "^11.1.4",
        "ioredis": "^5.9.2",
        "lodash": "^4.17.23",
        "reflect-metadata": "^0.2.2",
        "tsyringe": "^4.10.0",
        "uuid": "^13.0.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/uuid": "^10.0.0",
        "concurrently": "^9.2.1"
    }
}
