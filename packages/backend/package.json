{
    "name": "@pretzel-graph/backend",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "dev": "nodemon -w src -e ts,json --exec ts-node -r tsconfig-paths/register src/main.ts",
        "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && mkdir -p dist/backend/migrations dist/backend/assets && cp migrations/*.sql dist/backend/migrations/ && cp -R assets/. dist/backend/assets/",
        "start": "node dist/backend/src/main.js"
    },
    "dependencies": {
        "@nestjs/bullmq": "^11.0.4",
        "@nestjs/common": "^11.1.16",
        "@nestjs/core": "^11.1.16",
        "@nestjs/platform-express": "^11.1.16",
        "@nestjs/platform-ws": "^11.1.16",
        "@nestjs/throttler": "^6.5.0",
        "@nestjs/websockets": "^11.1.16",
        "@pretzel-graph/node-sdk": "*",
        "@pretzel-graph/shared": "*",
        "@supabase/auth-js": "^2.105.4",
        "bullmq": "^5.67.2",
        "cors": "^2.8.6",
        "dotenv": "^17.2.3",
        "express": "^5.2.1",
        "ioredis": "^5.9.2",
        "kysely": "^0.29.4",
        "nestjs-zod": "^5.1.1",
        "pg": "^8.22.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "ws": "^8.19.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/pg": "^8.21.0",
        "@types/ws": "^8.18.1",
        "nodemon": "^3.1.14",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.9.1",
        "tsc-watch": "^7.2.0",
        "tsconfig-paths": "^4.2.0"
    }
}
