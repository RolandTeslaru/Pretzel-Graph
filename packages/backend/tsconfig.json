{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@pretzel-graph/node-sdk": [
                "../node-sdk/src/index.ts"
            ],
            "@pretzel-graph/node-sdk/*": [
                "../node-sdk/src/*"
            ],
            "@pretzel-graph/nodes": [
                "../nodes/src/index.ts"
            ],
            "@pretzel-graph/nodes/*": [
                "../nodes/src/*"
            ],
            "@pretzel-graph/worker": [
                "../worker/src/index.ts"
            ],
            "@pretzel-graph/worker/*": [
                "../worker/src/*"
            ],
            "src/*": [
                "../worker/src/*"
            ]
        },
        "rootDir": "..",
        "outDir": "./dist",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "noImplicitOverride": true,
        "strict": true,
        "skipLibCheck": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true
    },
    "ts-node": {
        "compilerOptions": {
            "module": "CommonJS",
            "moduleResolution": "Node10"
        }
    },
    "include": [
        "src/**/*"
    ]
}
