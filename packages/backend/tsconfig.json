{
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "moduleResolution": "node",
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@vx-agent-builder/worker": [
                "../worker/src/index.ts"
            ],
            "@vx-agent-builder/worker/*": [
                "../worker/src/*"
            ],
            "src/*": [
                "../worker/src/*"
            ]
        },
        "outDir": "./dist",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "noImplicitOverride": true,
        "strict": true,
        "skipLibCheck": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true
    },
    "include": [
        "src/**/*"
    ]
}