{
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "moduleResolution": "node",
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "src/*"
            ],
            "@vx-agent-builder/vx-aggex": [
                "../vx-aggex/src/index.ts"
            ],
            "@vx-agent-builder/vx-aggex/*": [
                "../vx-aggex/src/*"
            ],
            "src/*": [
                "../vx-aggex/src/*"
            ]
        },
        "outDir": "./dist",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "noImplicitOverride": true,
        "strict": true,
        "skipLibCheck": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true
    },
    "include": [
        "src/**/*"
    ]
}